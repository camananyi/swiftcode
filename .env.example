# Copy to .env and fill in. Never commit the real .env.

# SwiftInference API key (STT + extraction LLM, all profiles)
SWIFT_API_KEY=

# Anthropic API key (post-event narrative, debrief, judge Q&A only)
ANTHROPIC_API_KEY=

# Overrides config/profiles.json "active_profile" when set: cloud | localhost | lan
SWIFTCODE_PROFILE=localhost
